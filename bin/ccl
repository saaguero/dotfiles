#!/usr/bin/env bash
# Claude Code pointed at the LOCAL LLM (llama-swap on the Linux box, native /v1/messages endpoint).
# Opt-in: does NOT touch the regular cloud `claude`. Usage: claude-local [--pick] [claude args...]
# Optional overrides:
#   CLAUDE_LOCAL_MODEL=qwen3.6-35b claude-local          # change main model
#   CLAUDE_LOCAL_FAST_MODEL=qwen3.6-35b claude-local     # background-tasks model
#   LLM_HOST=http://other-ip:8080  claude-local          # change server
# --pick: list the models available on the server and choose one before launching.
# NOTE: default driver switched to qwopus3.6-27b (2026-07-06, user request). The old
#   "reasoners break tool calling" bug (llama.cpp #20260/#21158) no longer reproduced on
#   build-cuda131 (see BITACORA 2026-06-29). If tool calls break via /v1/messages, fall
#   back with: CLAUDE_LOCAL_MODEL=qwen3.6-35b claude-local
# NOTE: the fast/background model follows the main one by default on purpose — mixing two
#   models makes llama-swap reload weights on every background request (15-40s swap thrash).

LLM_HOST="${LLM_HOST:-http://192.168.0.53:8080}"
MAIN="${CLAUDE_LOCAL_MODEL:-qwopus3.6-27b}"

# NOTE: no short -p alias — it would shadow claude's own -p/--print flag.
if [[ "${1:-}" == "--pick" ]]; then
  shift
  MODELS=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && MODELS+=("$line")
  done < <(curl -s --max-time 5 "$LLM_HOST/v1/models" | python3 -c '
import json, sys
try:
    for m in json.load(sys.stdin).get("data", []):
        print(m["id"])
except Exception:
    pass')
  if [[ ${#MODELS[@]} -eq 0 ]]; then
    echo "claude-local: could not list models from $LLM_HOST (server down?)" >&2
    exit 1
  fi
  echo "Available models on $LLM_HOST:" >&2
  for i in "${!MODELS[@]}"; do
    marker=""
    [[ "${MODELS[$i]}" == "$MAIN" ]] && marker="  (default)"
    printf '  %d) %s%s\n' "$((i + 1))" "${MODELS[$i]}" "$marker" >&2
  done
  printf 'Model [1-%d, Enter=default]: ' "${#MODELS[@]}" >&2
  read -r choice
  if [[ -n "$choice" ]]; then
    if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#MODELS[@]})); then
      MAIN="${MODELS[$((choice - 1))]}"
    else
      echo "claude-local: invalid choice '$choice'" >&2
      exit 1
    fi
  fi
fi

FAST="${CLAUDE_LOCAL_FAST_MODEL:-$MAIN}"

export ANTHROPIC_BASE_URL="$LLM_HOST"
export ANTHROPIC_AUTH_TOKEN="local"                # dummy: skips the cloud OAuth login
export ANTHROPIC_MODEL="$MAIN"
export ANTHROPIC_SMALL_FAST_MODEL="$FAST"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MAIN"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MAIN"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$FAST"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_LOCAL_CTX:-131072}"  # real server ctx (-c in llama-swap.yaml): auto-compact before the 400
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1  # local mode: no cloud telemetry
export CLAUDE_CODE_ATTRIBUTION_HEADER=0            # avoids a header that invalidates the KV cache (~90% slower)
export DISABLE_AUTOUPDATER=1                       # no auto-update in local mode

# Session-scoped settings (same --settings pattern as the cczype alias):
# - zype-dev-assistant plugin stays off (explicit here even though the global default is off)
# - deny the built-in claude-api skill: it dumps ~174k tokens of API reference docs into
#   context, which overflows the local server window (see BITACORA 2026-07-06)
LOCAL_SETTINGS='{"enabledPlugins":{"zype-dev-assistant@zype-dev-assistant":false},"permissions":{"deny":["Skill(claude-api)"]}}'

echo "# claude-local -> $LLM_HOST   (main=$MAIN, fast=$FAST)  [skip-permissions ON, claude-api skill OFF, zype plugin OFF]" >&2
exec claude --dangerously-skip-permissions --settings "$LOCAL_SETTINGS" "$@"
